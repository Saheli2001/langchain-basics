{
    "title": "Student",
    "description": "Schema about students",
    "type": "object",
    "properties": {
        "name": "string",
        "age": {
            "type": "integer",
            "description": "The age of the student"
        },
        "key_themes": {
        "type": "array",
        "items": {
            "type": "string"
        },
        "description": "A list of key themes mentioned in the review"
        },
        "summary": {
        "type": "string",
        "description": "A short summary of the review"
        },
        "sentiment": {
        "type": "string",
        "enum": ["pos", "neg"],
        "description": "The sentiment of the review (positive, negative, or neutral)"
        },
        "pros": {
        "type": ["array", "null"],
        "items": {
            "type": "string"
        },
        "description": "A list of pros mentioned in the review, if any"
        },
        "cons": {
        "type": ["array", "null"],
        "items": {
            "type": "string"
        },
        "description": "A list of cons mentioned in the review, if any"
        }
    },
    "required": ["name", "key_themes", "summary", "sentiment"]
}